{
  "version": 3,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["prisma/schema.prisma"]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/api/$1"
    }
  ],
  "env": {
    "DATABASE_URL": "@database_url",
    "SUPABASE_KEY": "@supabase_key",
    "SUPABASE_URL": "@supabase_url"
  },
  "build": {
    "env": {
      "DATABASE_URL": "@database_url",
      "SUPABASE_KEY": "@supabase_key",
      "SUPABASE_URL": "@supabase_url"
    }
  }
}